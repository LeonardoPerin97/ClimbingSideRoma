DJANGO_SETTINGS_MODULE=config.settings.development
DJANGO_SECRET_KEY=change-me-in-local-development
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Omettere DATABASE_URL per usare SQLite in sviluppo locale.
# DATABASE_URL=postgresql://climbingside:climbingside@localhost:5432/climbingside
DJANGO_DEFAULT_LANGUAGE=it
DJANGO_LOG_LEVEL=INFO
LOGIN_FAILURE_LIMIT=5
LOGIN_LOCKOUT_MINUTES=15

# Production-only examples. Never commit real values.
DJANGO_CSRF_TRUSTED_ORIGINS=
DJANGO_SECURE_SSL_REDIRECT=true
DJANGO_HSTS_SECONDS=31536000
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=ClimbingSide <no-reply@example.com>

# Required in production. Keep the real value only in the hosting secret store.
# Format: cloudinary://API_KEY:API_SECRET@CLOUD_NAME
CLOUDINARY_URL=
